{
  "manifest_version": 3,
  "name": "UI Atlas",
  "version": "0.1.0",
  "description": "Capture the page you are already looking at, in a clean window.",
  "permissions": ["nativeMessaging", "tabs"],
  "action": {
    "default_title": "UI Atlas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:"
  }
}
